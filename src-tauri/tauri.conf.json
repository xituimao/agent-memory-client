{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Memory",
  "version": "0.1.0",
  "identifier": "io.github.xituimao.agent-memory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 340,
        "height": 460,
        "minWidth": 320,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "agentmemory 极简客户端：自动 SSH 隧道 + 状态托盘",
    "longDescription": "自动建立并维护到 agentmemory 服务器的 SSH 隧道，系统栏实时显示连接状态，一键打开记忆查看器。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
